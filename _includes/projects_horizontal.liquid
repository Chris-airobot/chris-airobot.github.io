{% comment %}
Shared, responsive project card.
Desktop: equal media / text columns. Mobile: stacked.
External GitHub links are siblings of the card's main link, not nested anchors.
{% endcomment %}
<div class="portfolio-project-entry">
  <div class="card hoverable portfolio-project-card">
    <a class="portfolio-project-main" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      <div class="portfolio-project-media{% unless project.img %} portfolio-project-placeholder{% endunless %}">
        {% if project.preview_animation %}
          <img class="portfolio-project-visual"
            src="{{ project.preview_animation | relative_url }}?v=portfolio3"
            alt="{{ project.title | escape }} animated preview"
            loading="eager" decoding="async">
        {% elsif project.preview_video %}
          <video class="portfolio-project-visual project-card-video{% if project.preview_video_fit == 'contain' %} portfolio-project-contain{% endif %}"
            autoplay muted loop playsinline preload="metadata"
            poster="{{ project.img | relative_url }}"
            aria-label="{{ project.title | escape }} video preview">
            <source src="{{ project.preview_video | relative_url }}" type="video/mp4">
          </video>
        {% elsif project.img %}
          <img class="portfolio-project-visual"
            src="{{ project.img | relative_url }}"
            alt="{{ project.title | escape }} project preview"
            loading="lazy">
        {% else %}
          <span class="portfolio-project-placeholder-label">ROBOTICS RESEARCH</span>
          <span class="portfolio-project-placeholder-mark">PROJECT</span>
        {% endif %}
      </div>
      <div class="portfolio-project-copy">
        <h3 class="card-title">{{ project.title }}</h3>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </a>
    {% if project.github %}
      <a class="portfolio-project-code" href="{{ project.github }}" target="_blank" rel="noopener noreferrer"
        aria-label="View source code for {{ project.title | escape }}">
        <i class="fa-brands fa-github" aria-hidden="true"></i><span>Code</span>
      </a>
    {% endif %}
  </div>
</div>
